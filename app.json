{
  "expo": {
    "name": "Insane GPS",
    "slug": "insane-gps",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/gpsinsano.png",
    "scheme": "gpsclean",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.insanelabs.insanegps",
      "versionCode": 31,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/gpsinsano.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gpsinsano.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "image": "./assets/images/gpsinsano.png",
            "backgroundColor": "#E6F4FE"
          }
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita acesso as fotos para enviar imagens no chat e no fale conosco."
        }
      ],
      "expo-localization",
      "expo-notifications",
      "expo-font",
      "expo-asset",
      "react-native-iap",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c9d2113-5abb-49f3-8e0f-0b4f10d60627"
      }
    },
    "owner": "insane_labs"
  }
}
