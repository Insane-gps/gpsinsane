{
  "expo": {
    "name": "Insane GPS",
    "slug": "insane-gps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gpsinsano.png",
    "scheme": "gpsclean",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ocimar.gpsclean",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/gpsinsano.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita acesso as fotos para enviar imagens no chat e no fale conosco.",
          "cameraPermission": "Permita acesso a camera para tirar fotos e enviar no chat e no fale conosco.",
          "microphonePermission": "Permita acesso ao microfone para gravar audio no chat."
        }
      ],
      "expo-localization",
      "expo-notifications",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e6645d7-7ba1-4dc6-9e39-86966cea2f09"
      }
    },
    "owner": "ocimar"
  }
}